#!/bin/sh
# Заглушка xdg-open приёмки: браузер не запускается никогда. Адрес, который killswitch window просит открыть,
# дописывается в файл прогона — его читает раннер. Без файла — отказ: вызов вне приёмки виден сразу.
[ -n "${KSL_OPEN_LOG:-}" ] || { echo "заглушка xdg-open: не задан KSL_OPEN_LOG" >&2; exit 1; }
printf '%s\n' "$1" >> "$KSL_OPEN_LOG"
exit 0
