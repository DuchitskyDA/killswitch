		meta l4proto { tcp, udp } th sport 61046 counter drop comment "probe 61046"
		meta l4proto { tcp, udp } th sport 61047 counter drop comment "probe 61047"
		meta l4proto { tcp, udp } th sport 61048 counter drop comment "probe 61048"
		meta l4proto { tcp, udp } th sport 61049 counter drop comment "probe 61049"
		meta l4proto { tcp, udp } th sport 61050 counter drop comment "probe 61050"
		meta l4proto { tcp, udp } th sport 61051 counter drop comment "probe 61051"
		meta l4proto { tcp, udp } th sport 61052 counter drop comment "probe 61052"
		meta l4proto { tcp, udp } th sport 61053 counter drop comment "probe 61053"
		meta l4proto { tcp, udp } th sport 61054 counter drop comment "probe 61054"
		meta l4proto { tcp, udp } th sport 61055 counter drop comment "probe 61055"
		meta l4proto { tcp, udp } th sport 61056 counter drop comment "probe 61056"
		meta l4proto { tcp, udp } th sport 61057 counter drop comment "probe 61057"
		meta l4proto { tcp, udp } th sport 61058 counter drop comment "probe 61058"
		meta l4proto { tcp, udp } th sport 61059 counter drop comment "probe 61059"
		meta l4proto { tcp, udp } th sport 61060 counter drop comment "probe 61060"
		meta l4proto { tcp, udp } th sport 61061 counter drop comment "probe 61061"
		meta l4proto { tcp, udp } th sport 61062 counter drop comment "probe 61062"
		meta l4proto { tcp, udp } th sport 61063 counter drop comment "probe 61063"
		counter drop comment "final"
	}
}
