		meta l4proto { tcp, udp } th sport 30048 counter comment "egress 30048"
		meta l4proto { tcp, udp } th sport 30049 counter comment "egress 30049"
		meta l4proto { tcp, udp } th sport 30050 counter comment "egress 30050"
		meta l4proto { tcp, udp } th sport 30051 counter comment "egress 30051"
		meta l4proto { tcp, udp } th sport 30052 counter comment "egress 30052"
		meta l4proto { tcp, udp } th sport 30053 counter comment "egress 30053"
		meta l4proto { tcp, udp } th sport 30054 counter comment "egress 30054"
