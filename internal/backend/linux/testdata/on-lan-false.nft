# killswitch linux: режим on
table inet killswitch
delete table inet killswitch
table inet killswitch {
	chain postrouting {
		type filter hook postrouting priority filter - 10; policy drop;
		oifname "lo" accept
		meta iiftype != loopback fib saddr type != local accept comment "transit"
		oifname "wg0" accept
		udp sport 68 udp dport 67 accept
		udp sport 546 udp dport 547 accept
		icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert, packet-too-big, mld-listener-report, mld2-listener-report } accept
		meta l4proto { tcp, udp } th sport 30000-30063 goto egress comment "check probes"
		goto rest
	}

	chain egress {
		meta l4proto { tcp, udp } th sport 30000 counter comment "egress 30000"
		meta l4proto { tcp, udp } th sport 30001 counter comment "egress 30001"
		meta l4proto { tcp, udp } th sport 30002 counter comment "egress 30002"
		meta l4proto { tcp, udp } th sport 30003 counter comment "egress 30003"
		meta l4proto { tcp, udp } th sport 30004 counter comment "egress 30004"
		meta l4proto { tcp, udp } th sport 30005 counter comment "egress 30005"
