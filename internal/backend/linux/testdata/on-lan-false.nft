		meta l4proto { tcp, udp } th sport 30059 counter comment "egress 30059"
		meta l4proto { tcp, udp } th sport 30060 counter comment "egress 30060"
		meta l4proto { tcp, udp } th sport 30061 counter comment "egress 30061"
		meta l4proto { tcp, udp } th sport 30062 counter comment "egress 30062"
		meta l4proto { tcp, udp } th sport 30063 counter comment "egress 30063"
		goto rest
	}

	chain rest {
		ip daddr 10.0.0.0/8 meta l4proto { tcp, udp } th dport 53 accept
		ip daddr 172.16.0.0/12 meta l4proto { tcp, udp } th dport 53 accept
		ip daddr 192.168.0.0/16 meta l4proto { tcp, udp } th dport 53 accept
		ip daddr 169.254.0.0/16 meta l4proto { tcp, udp } th dport 53 accept
		ip6 daddr fc00::/7 meta l4proto { tcp, udp } th dport 53 accept
		ip6 daddr fe80::/10 meta l4proto { tcp, udp } th dport 53 accept
		ip daddr 192.168.1.1 meta l4proto { tcp, udp } th dport 53 accept
		ip daddr 203.0.113.53 meta l4proto { tcp, udp } th dport 53 accept
		meta l4proto { tcp, udp } th dport 53 goto deny
		goto deny
	}

	chain deny {
		meta l4proto { tcp, udp } th sport 30000 counter drop comment "probe 30000"
		meta l4proto { tcp, udp } th sport 30001 counter drop comment "probe 30001"
		meta l4proto { tcp, udp } th sport 30002 counter drop comment "probe 30002"
		meta l4proto { tcp, udp } th sport 30003 counter drop comment "probe 30003"
		meta l4proto { tcp, udp } th sport 30004 counter drop comment "probe 30004"
		meta l4proto { tcp, udp } th sport 30005 counter drop comment "probe 30005"
		meta l4proto { tcp, udp } th sport 30006 counter drop comment "probe 30006"
